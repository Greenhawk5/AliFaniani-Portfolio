{
  "name": "ali-faniani-portfolio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Interactive 3D developer portfolio of Ali Faniani",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint src functions",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"functions/**/*.ts\"",
    "typecheck": "tsc -b",
    "check:functions": "tsc --noEmit -p tsconfig.functions.json",
    "deploy": "npm run build && wrangler pages deploy dist"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "@react-three/postprocessing": "^3.1.0",
    "framer-motion": "^13.1.1",
    "gsap": "^3.15.0",
    "postprocessing": "^6.39.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-error-boundary": "^6.1.3",
    "react-router-dom": "^7.18.2",
    "three": "^0.185.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260823.1",
    "@eslint/js": "^10.0.1",
    "@gltf-transform/cli": "^4.4.2",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "^6.1.0",
    "eslint": "^10.9.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^17.11.0",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.2"
  }
}

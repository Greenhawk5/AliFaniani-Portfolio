{
  "name": "ali-faniani-portfolio",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "description": "Portfolio of Ali Faniani — software developer focused on AI, backend, web, and automation. Includes an interactive 3D developer room at /room.",
  "scripts": {
    "dev": "vite",
    "sitemap": "node scripts/generate-sitemap.mjs",
    "build": "node scripts/build.mjs",
    "build:local-snapshot": "CMS_SNAPSHOT_LOCAL=1 node scripts/build.mjs",
    "media": "node scripts/generate-media-manifest.mjs",
    "migrate:local": "node scripts/migrate-content-to-d1.mjs",
    "migrate:dry-run": "node scripts/migrate-content-to-d1.mjs --dry-run",
    "migrate:remote-seed": "node scripts/migrate-content-to-d1.mjs --remote",
    "snapshot:local": "node scripts/export-d1-snapshot.mjs --local",
    "preview": "vite preview",
    "lint": "eslint src functions",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"functions/**/*.ts\"",
    "typecheck": "node scripts/generate-version.mjs && tsc -b",
    "check:functions": "tsc --noEmit -p tsconfig.functions.json",
    "verify:build": "node scripts/verify-build.mjs",
    "test": "vitest run",
    "deploy": "npm run build && wrangler pages deploy dist",
    "test:ci": "vitest run --exclude \"tests/seo-e2e.test.ts\""
  },
  "dependencies": {
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.1",
    "@react-three/postprocessing": "^3.1.3",
    "framer-motion": "^13.4.6",
    "gsap": "^3.15.0",
    "postprocessing": "^6.39.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-error-boundary": "^6.1.6",
    "react-router-dom": "^7.18.4",
    "three": "^0.186.1",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260930.2",
    "@eslint/js": "^10.0.1",
    "@gltf-transform/cli": "^4.5.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.1",
    "vitest": "^5.0.3"
  }
}
